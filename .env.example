# ==========================================
# Google OAuth 2.0 (YouTube Data API v3)
# ==========================================
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Authorized Redirect URI must match what is registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://youtube-ai-automation-five.vercel.app/api/auth/google/callback

# (Optional) Pre-configured Refresh Token for serverless persistence on Vercel
# Once you authorize via the dashboard, you can also paste the generated refresh token here
YOUTUBE_REFRESH_TOKEN=

# ==========================================
# AI Model & Generation Services
# ==========================================
GEMINI_API_KEY=your-gemini-api-key

# (Optional) Stock Media APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# (Optional) ElevenLabs Voice API
ELEVENLABS_API_KEY=
